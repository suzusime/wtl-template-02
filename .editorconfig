root = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# リソースファイル
[*.rc]
charset = utf-16le
end_of_line = crlf
indent_style = space
indent_size = 4

# リソースヘッダ
[resource.h]
charset = utf-8-bom
end_of_line = crlf

[*.{md,txt}]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = false
max_line_length = off

[.editorconfig]
# BOMをつけてはならない
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
