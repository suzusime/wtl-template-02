root = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
end_of_line = lf
charset = utf-8-bom
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,txt}]
end_of_line = lf
charset = utf-8-bom
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = false
max_line_length = off

[.editorconfig]
end_of_line = lf
charset = utf-8-bom
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
